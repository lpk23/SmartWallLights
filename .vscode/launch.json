{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Run",
            "type": "node",
            "request": "launch",
            "cwd": "${workspaceFolder}/../../",
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen",
            "windows": {
                "runtimeExecutable": "${workspaceFolder}/../../RimWorldWin64.exe",
                "preLaunchTask": "BuildWindowsDLL"
            },
            "linux": {
                "runtimeExecutable": "sh",
                "runtimeArgs": [
                    "-c",
                    "if [ -f ./run.sh ]; then ./run.sh; else ./RimWorldLinux; fi"
                ],
                "preLaunchTask": "BuildLinuxDLL"
            }
        },
        {
            "name": "Attach Debugger",
            "type": "mono",
            "request": "attach",
            "address": "127.0.0.1",
            "port": 56000
        }
    ],
    "compounds": [
        {
            "name": "Build & Debug",
            "configurations": [
                "Build & Run",
                "Attach Debugger"
            ],
            "stopAll": true
        }
    ]
}
